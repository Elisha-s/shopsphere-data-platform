# Copy to .env (which is git-ignored) and fill in. Only needed for
#   python -m ingestion.run_producer --target eventhubs
EVENTHUB_NAMESPACE=shopsphere-events
EVENTHUB_PRODUCER_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<send-policy>;SharedAccessKey=<key>
EVENTHUB_TOPIC=orders
